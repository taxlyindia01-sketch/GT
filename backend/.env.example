# GoldTrader Pro v4 — Environment Variables
# ─────────────────────────────────────────────────────────────
# LOCAL DEV: copy to .env and fill in values
# RENDER.COM: add each variable in Service → Environment tab
# ─────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────

# PostgreSQL connection string
# Render: use the "Internal Database URL" from your PostgreSQL service
# Local:  postgresql+asyncpg://postgres:yourpassword@localhost:5432/goldtrader_pro
DATABASE_URL=postgresql+asyncpg://postgres:GT123@localhost:5432/goldtrader

# JWT signing secret — must be random, 32+ chars
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-32-char-random-string-here

# Taxly super-admin credentials
TAXLY_ADMIN_USERNAME=Taxly
# Hash of @Gsf025@ — regenerate if you change the password:
# python -c "import bcrypt; print(bcrypt.hashpw(b'@Gsf025@', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=$2b$12$ZhJuQ.tZKyxLgVT/GqrzBeX20BFpN0sFKhzMBPUW0HbtnYKR8Mlsi

# ── OPTIONAL ─────────────────────────────────────────────────

TRIAL_DAYS=10
DEBUG=False
FRONTEND_URL=*

# Google OAuth (leave blank to disable Google login)
GOOGLE_CLIENT_ID=863366877040-e8bi45pfb3mo1ec03c395g8dbaatvke5.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

# Email SMTP (leave blank to disable email notifications)
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# S3 (leave blank to disable backup downloads)
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
